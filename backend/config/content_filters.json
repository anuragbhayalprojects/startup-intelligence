{
  "article_body_selectors": [
    ".article-content", ".post-content", ".entry-content",
    "article", "[class*='article-body']", "[class*='post-body']",
    ".story-body", ".news-body", ".elementor-widget-theme-post-content",
    ".td-post-content", ".single-post-content", ".article__body",
    ".post__body", ".content-area", ".main-content"
  ],

  "blocked_phrases": [
    "Unlock with Inc42 Plus", "D2CX", "ManagementX",
    "Subscribe to our", "newsletter", "Tired Of Hustle",
    "Follow us on", "Terms of Use", "Privacy Policy",
    "Inc42+ Exclusive", "Join our community",
    "consent to the processing", "By clicking the button",
    "disclaimer", "Disclaimer:", "Disclosure:"
  ],

  "blocked_patterns": [
    "^\\s*Advertisement\\s*$",
    "^\\s*Sponsored\\s*$",
    "^\\s*Promoted\\s*$",
    "Read more at .{1,60}$",
    "^\\s*---+\\s*$",
    "^\\s*\\.{3,}\\s*$"
  ],

  "disclaimer_patterns": [
    "views? expressed (are|is) (the |his |her |their |author|own)",
    "opinions? expressed (are|is) (the |his |her |their |author|own)",
    "this (article|content|post|story|piece|report) (is|does|should|must) not",
    "does not constitute (financial|legal|investment|professional|tax) advice",
    "for informational purposes? only",
    "not intended as (financial|legal|investment|professional)",
    "consult (a|your|an) (qualified|licensed|professional|financial|legal)",
    "not financial advice",
    "past performance (is|does) not",
    "invest(ment|ing)? (involves?|carry|carries) risk",
    "all rights reserved",
    "reproduction (without|of this) .{0,40} (is |are )?(prohibited|not permitted)",
    "copyright \\d{4}",
    "\\© \\d{4}",
    "the above (content|article|information|story) is (for|a) (informational|sponsored|partner)",
    "this is a (sponsored|partner|advertorial|branded) (article|content|post|story)",
    "sponsored content",
    "partner content",
    "branded content"
  ],

  "author_bio_signals": [
    "(the )?author (has|is|was|works|worked|covers|covered)",
    "is a (senior |veteran |freelance |independent |staff |contributing )?journalist",
    "is a (senior |veteran |freelance |independent |contributing )?writer",
    "is a (senior |staff |contributing )?reporter",
    "is a (senior |staff |contributing )?editor",
    "is a contributor (to|at|for)",
    "has (\\d+|over|more than) years (of experience|in journalism|in reporting|covering)",
    "can be reached at",
    "can be contacted at",
    "write to (us|him|her|them) at",
    "graduated from",
    "previously (worked|wrote|reported|covered) (at|for)",
    "has worked (at|for|with)",
    "follow (him|her|them) on (twitter|linkedin|instagram|x)",
    "(his|her|their) (work|writing|reporting) (has appeared|has been published|appears) in"
  ],

  "cta_signals": [
    "subscribe (now|today|for free|to (our|the|get))",
    "sign up (for|to|now)",
    "register (now|today|for free|to get)",
    "get (early )?access",
    "download (our|the|this|your|now)",
    "click here to",
    "join (our|the) (community|newsletter|waitlist|discord|slack|telegram)",
    "follow us on (twitter|linkedin|instagram|facebook|youtube|x)",
    "stay (updated|tuned|informed|connected)",
    "get (the latest|our latest|daily|weekly) (news|updates|insights|stories|digest)",
    "read (more|also|next|our)",
    "share (this|the) (article|story|post|content)",
    "like and share",
    "don.t forget to",
    "hit the (subscribe|like|bell) button"
  ],

  "footer_keywords": [
    "about us", "contact us", "advertise", "write for us",
    "editorial policy", "corrections policy", "terms of service",
    "cookie policy", "sitemap", "rss feed", "careers at",
    "our team", "work with us", "pitch us", "submit a story"
  ],

  "min_paragraph_length": 65,
  "max_paragraphs_for_context": 3,
  "max_stored_paragraphs": 10,
  "footer_position_ratio": 0.75,
  "short_footer_max_length": 130,
  "context_validation_threshold": 0.30
}
